# Keep the build context small and free of secrets.
.env
.env.*
!.env.example

.git/
.gitignore

__pycache__/
*.py[cod]
.venv/
venv/

.pytest_cache/
.deepeval/
.deepeval-cache.json
*.log

.DS_Store
Thumbs.db
.ipynb_checkpoints/

# Docs and dev-only files are not needed in the runtime image.
*.md
!README.md
