# Copy to .env and fill in. Never commit the real .env.

# --- Keys (read from the environment only; never hardcoded in code) ---
# OpenAI key powers: the vision answering model (gpt-4o-mini via the gateway),
# the OpenAI text-embedding backend if you switch to it, the NeMo Guardrails
# checks, the A2A verifier, and the DeepEval judge.
OPENAI_API_KEY=

# Optional: a Groq key enables the gateway fallback to groq/openai/gpt-oss-120b.
GROQ_API_KEY=

# --- Text encoder backend: "minilm" (local, no key) or "openai" ---
TEXT_ENCODER_BACKEND=minilm
OPENAI_TEXT_EMBED_MODEL=text-embedding-3-small
MINILM_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Image encoder ---
CLIP_MODEL=openai/clip-vit-base-patch32

# --- Answering (vision) model + gateway fallbacks ---
VISION_MODEL=gpt-4o-mini
GATEWAY_FALLBACKS=gpt-4o,groq/openai/gpt-oss-120b
GATEWAY_CACHE=true
# Per-call wall-clock cap in seconds; a stalled provider fails here and the
# fallback chain takes over instead of hanging the app.
GATEWAY_TIMEOUT_SEC=60

# --- Guardrails ---
GUARDRAILS_ENABLED=true
GUARDRAILS_MODEL=gpt-4o-mini

# --- Retrieval ---
TEXT_CHUNK_SIZE=500
TEXT_CHUNK_OVERLAP=100
TOP_K_TEXT=4
TOP_K_IMAGE=3

# --- Eval gate ---
EVAL_JUDGE_MODEL=gpt-4o-mini
EVAL_THRESHOLD=0.7

# --- A2A / runtime verify loop ---
VERIFY_ANSWERS=false
VERIFY_MAX_RETRIES=1
