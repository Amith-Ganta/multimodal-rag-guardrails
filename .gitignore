# --- Secrets: never commit real keys ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.python-version

# --- Test / eval caches and local run logs ---
.pytest_cache/
.deepeval/
.deepeval-cache.json
*.log

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
.ipynb_checkpoints/

# --- Terraform (applies recursively to every module, e.g. terraform/eks/) ---
.terraform/
.terraform.lock.hcl
terraform.tfstate
terraform.tfstate.backup
terraform.tfvars
*.tfplan
tfplan*.out
terraform/deploy-secrets.txt

# --- Ansible ---
ansible/inventory.ini
ansible/vault.yml
ansible/.vault_pass
ansible/*.retry
