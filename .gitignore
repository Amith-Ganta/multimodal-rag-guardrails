# --- Secrets: never commit real keys ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.python-version

# --- Test / eval caches and local run logs ---
.pytest_cache/
.deepeval/
.deepeval-cache.json
*.log

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
.ipynb_checkpoints/

# --- Terraform (applies recursively to every module, e.g. terraform/eks/) ---
.terraform/
.terraform.lock.hcl
# Wildcarded rather than the two exact filenames. A state file that has been
# renamed or archived (terraform.tfstate.pre-s3-migration and the like) is
# still a full inventory of the account's resources, and the exact-name form
# quietly let those through.
*.tfstate
*.tfstate.*
.state-archive/
terraform.tfvars
*.tfplan
tfplan*.out
terraform/deploy-secrets.txt

# --- Ansible ---
ansible/inventory.ini
ansible/vault.yml
ansible/.vault_pass
ansible/*.retry
